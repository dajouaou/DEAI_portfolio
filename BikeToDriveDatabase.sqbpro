    adres TEXT,
    provincie TEXT
);

CREATE TABLE Fiets_Verkoop_Fabrikant (
    fabrikantnr INTEGER PRIMARY KEY,
    naam TEXT,
    adres TEXT,
    plaats TEXT
);</sql><current_tab id="0"/></tab_sql></sqlb_project>

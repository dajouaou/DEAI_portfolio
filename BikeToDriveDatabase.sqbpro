CREATE TABLE Onderhoud (
	onderhoudnr INT PRIMARY KEY,
	datum DATE,
	starttijd TIME,
	eindtijd TIME,
	fiets INT NOT NULL,
	monteur INT NOT NULL
);

CREATE TABLE Onderhoud_Monteur (
	monteurnr INT PRIMARY KEY,
	naam VARCHAR(45),
	woonplaats VARCHAR(45),
	uurloon FLOAT,
	filiaal INT NOT NULL
);

CREATE TABLE Onderhoud_Fiets (
	fietsnr INT PRIMARY KEY,
	soort VARCHAR(45),
	merk VARCHAR(45),
	type VARCHAR(45),
	standaardprijs FLOAT,
	inkoopprijs FLOAT,
	kleur VARCHAR(20),
	fabrikant INT NOT NULL
);

CREATE TABLE Onderhoud_Filiaal (
	filiaalnr INT PRIMARY KEY,
	naam VARCHAR(45),
	adres VARCHAR(100),
	provincie VARCHAR(20)
);

CREATE TABLE Onderhoud_Fabrikant (
	fabrikantnr INT PRIMARY KEY,
	naam VARCHAR(45),
	adres VARCHAR(100),
	plaats VARCHAR(45)
);

-- Accessoire_Inkoop
CREATE TABLE Accessoire_Inkoop (
	inkoopnr INT PRIMARY KEY,
	inkoopmaand INT,
	inkoopjaar INT,
	aantal INT,
	accessoire INT NOT NULL
);

CREATE TABLE Accessoire_Inkoop_Accessoire (
	accessoirenr INT PRIMARY KEY,
	naam VARCHAR(45),
	standaardprijs FLOAT,
	inkoopprijs FLOAT,
	soort VARCHAR(45),
	leverancier INT NOT NULL
);

CREATE TABLE Accessoire_Inkoop_Leverancier (
	leveranciernr INT PRIMARY KEY,
	naam VARCHAR(45),
	adres VARCHAR(100),
	woonplaats VARCHAR(45)
);

-- Fiets_Inkoop
CREATE TABLE Fiets_Inkoop (
	inkoopnr INT PRIMARY KEY,
	inkoopmaand INT,
	inkoopjaar INT,
	aantal INT,
	fiets INT NOT NULL
);

CREATE TABLE Fiets_Inkoop_Fiets (
	fietsnr INT PRIMARY KEY,
	soort VARCHAR(45),
	merk VARCHAR(45),
	type VARCHAR(45),
	standaardprijs FLOAT,
	inkoopprijs FLOAT,
	kleur VARCHAR(20),
	fabrikant INT NOT NULL
);

CREATE TABLE Fiets_Inkoop_Fabrikant (
	fabrikantnr INT PRIMARY KEY,
	naam VARCHAR(45),
	adres VARCHAR(100),
	plaats VARCHAR(45)
);

-- Accessoire_Verkoop
CREATE TABLE Accessoire_Verkoop (
    accessoire_verkoopnr INTEGER PRIMARY KEY,
    datum VARCHAR(10),
    aantal INTEGER,
    verkoopprijs FLOAT,
    klant INTEGER NOT NULL,
    accessoire INTEGER NOT NULL,
    monteur INTEGER NOT NULL
);

CREATE TABLE Accessoire_Verkoop_Klant (
    klantnr INTEGER PRIMARY KEY,
    naam TEXT,
    adres TEXT,
    woonplaats TEXT
);

CREATE TABLE Accessoire_Verkoop_Accessoire (
    accessoirenr INTEGER PRIMARY KEY,
    naam TEXT,
    standaardprijs FLOAT,
    inkoopprijs FLOAT,
    soort TEXT,
    leverancier INTEGER NOT NULL
);

CREATE TABLE Accessoire_Verkoop_Monteur (
    monteurnr INTEGER PRIMARY KEY,
    naam TEXT,
    woonplaats TEXT,
    uurloon FLOAT,
    filiaal INTEGER NOT NULL
);

CREATE TABLE Accessoire_Verkoop_Filiaal (
    filiaalnr INTEGER PRIMARY KEY,
    naam TEXT,
    adres TEXT,
    provincie TEXT
);

CREATE TABLE Accessoire_Verkoop_Leverancier (
    leveranciernr INTEGER PRIMARY KEY,
    naam TEXT,
    adres TEXT,
    woonplaats TEXT
);

-- Fiets_Verkoop
CREATE TABLE Fiets_Verkoop (
    fiets_verkoopnr INTEGER PRIMARY KEY,
    datum VARCHAR(10),
    aantal INTEGER,
    verkoopprijs REAL,
    klant INTEGER NOT NULL,
    fiets INTEGER NOT NULL,
    monteur INTEGER NOT NULL
);

CREATE TABLE Fiets_Verkoop_Klant (
    klantnr INTEGER PRIMARY KEY,
    naam TEXT,
    adres TEXT,
    woonplaats TEXT
);

CREATE TABLE Fiets_Verkoop_Fiets (
    fietsnr INTEGER PRIMARY KEY,
    soort TEXT,
    merk TEXT,
    type TEXT,
    standaardprijs FLOAT,
    inkoopprijs FLOAT,
    kleur TEXT,
    fabrikant INTEGER NOT NULL
);

CREATE TABLE Fiets_Verkoop_Monteur (
    monteurnr INTEGER PRIMARY KEY,
    naam TEXT,
    woonplaats TEXT,
    uurloon FLOAT,
    filiaal INTEGER NOT NULL
);

CREATE TABLE Fiets_Verkoop_Filiaal (
